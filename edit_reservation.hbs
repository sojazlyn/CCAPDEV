<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <title>Edit Reservation Packages</title>
  <style>
    .package-section {
      background: #f8f9fa;
      padding: 15px;
      border-radius: 10px;
      margin: 15px 0;
    }
    .package-option {
      border: 1px solid #dee2e6;
      border-radius: 8px;
      padding: 10px;
      margin: 5px 0;
      cursor: pointer;
    }
    .package-option.selected {
      background: #d1ecf1;
      border-color: #bee5eb;
    }
    .seat-map {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin: 10px 0;
    }
    .seat {
      width: 50px;
      height: 30px;
      background: #e0e0e0;
      text-align: center;
      line-height: 30px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 12px;
    }
    .seat.selected {
      background: #28a745;
      color: white;
    }
    .seat.occupied {
      background: #dc3545;
      color: white;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
  <div class="container mt-4">
    <h2>Edit Reservation Packages</h2>
    <p>Flight: {{reservation.flightId.flightNumber}} - {{reservation.flightId.origin}} to {{reservation.flightId.destination}}</p>
    <p>Passenger: {{reservation.passengerName}}</p>

    <form method="POST" action="/reservations/update/{{reservation._id}}">
      
      <!-- Meal Options -->
      <div class="package-section">
        <h4>Meal Options</h4>
        <div class="meal-options">
          <div class="package-option {{#if (eq reservation.mealOption.name 'Chips')}}selected{{/if}}" data-meal="Chips|0">
            <strong>Chips</strong> - PHP 0
          </div>
          <div class="package-option {{#if (eq reservation.mealOption.name 'Mixed Vegetables with Mashed Potato')}}selected{{/if}}" data-meal="Mixed Vegetables with Mashed Potato|150">
            <strong>Mixed Vegetables with Mashed Potato</strong> - PHP 150
          </div>
          <div class="package-option {{#if (eq reservation.mealOption.name 'Sausage with Hashbrown')}}selected{{/if}}" data-meal="Sausage with Hashbrown|270">
            <strong>Sausage with Hashbrown</strong> - PHP 270
          </div>
          <div class="package-option {{#if (eq reservation.mealOption.name 'Hainanese Soy Chicken with Brown Rice')}}selected{{/if}}" data-meal="Hainanese Soy Chicken with Brown Rice|320">
            <strong>Hainanese Soy Chicken with Brown Rice</strong> - PHP 320
          </div>
          <div class="package-option {{#if (eq reservation.mealOption.name 'Chives Dumpling with Japanese Gyudon')}}selected{{/if}}" data-meal="Chives Dumpling with Japanese Gyudon|360">
            <strong>Chives Dumpling with Japanese Gyudon</strong> - PHP 360
          </div>
        </div>
        <input type="hidden" id="mealOption" name="mealOption" value="{{reservation.mealOption.name}}|{{reservation.mealOption.price}}">
      </div>

      <!-- Baggage Options -->
      <div class="package-section">
        <h4>Extra Baggage</h4>
        <label>Additional Bags (PHP 500 per bag)</label>
        <input type="range" id="baggage" name="extraBaggage" class="form-range" min="0" max="5" value="{{reservation.baggage.quantity}}">
        <div id="baggageDisplay">{{reservation.baggage.quantity}} additional bags (PHP {{reservation.baggage.price}})</div>
      </div>

      <!-- Seat Selection -->
      <div class="package-section">
        <h4>Select Your Seat</h4>
        <p>Current seat: <strong>{{reservation.seat.number}}</strong></p>
        <div class="seat-map" id="seatMap"></div>
        <input type="hidden" id="selectedSeat" name="selectedSeat" value="{{reservation.seat.number}}">
      </div>

      <div class="mt-3">
        <button type="submit" class="btn btn-primary">Update Packages</button>
        <a href="/my-reservations" class="btn btn-secondary">Cancel</a>
        
        <!-- Remove Package Options -->
        <div class="mt-3">
          <h5>Remove Packages:</h5>
          <form action="/reservations/remove-package/{{reservation._id}}" method="POST" style="display: inline;">
            <input type="hidden" name="packageType" value="meal">
            <button type="submit" class="btn btn-outline-warning btn-sm">Remove Meal</button>
          </form>
          <form action="/reservations/remove-package/{{reservation._id}}" method="POST" style="display: inline;">
            <input type="hidden" name="packageType" value="baggage">
            <button type="submit" class="btn btn-outline-warning btn-sm">Remove Extra Baggage</button>
          </form>
        </div>
      </div>
    </form>
  </div>

  <script>
    $(document).ready(function(){
      // Meal selection
      $('.meal-options .package-option').click(function(){
        $('.meal-options .package-option').removeClass('selected');
        $(this).addClass('selected');
        $('#mealOption').val($(this).data('meal'));
      });

      // Baggage selection
      $('#baggage').on('input', function(){
        const count = parseInt($(this).val());
        $('#baggageDisplay').text(`${count} additional bags (PHP ${count * 500})`);
      });

      // Seat selection
      function initializeSeatMap() {
        const currentSeat = '{{reservation.seat.number}}';
        
        for(let row = 1; row <= 4; row++){
          for(let col = 1; col <= 15; col++){
            let seatNum = String.fromCharCode(64 + row) + col;
            let isOccupied = Math.random() < 0.3;
            let isCurrent = seatNum === currentSeat;
            
            let seatClass = "seat";
            if (isOccupied) seatClass += " occupied";
            if (isCurrent) seatClass += " selected";
            
            $("#seatMap").append(`<div class="${seatClass}" data-seat="${seatNum}">${seatNum}</div>`);
          }
        }
      }

      $(document).on("click", ".seat:not(.occupied)", function(){
        $(".seat.selected").removeClass("selected");
        $(this).addClass("selected");
        $('#selectedSeat').val($(this).data("seat"));
      });

      initializeSeatMap();
    });
  </script>
</body>
</html>
